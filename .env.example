# Copy to .env  (docker compose reads it automatically)
API_KEYS=dev-key-change-me          # comma-separated; clients send X-API-Key
RATE_LIMIT_PER_MIN=120
MAX_BATCH_SIZE=500
ALLOWED_ORIGINS=http://localhost:8000
STRICT_VERSIONS=false               # true = refuse to load model if xgboost major.minor differs
LOG_LEVEL=INFO
